# Postgres Credentials
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_SSLMODE=disable

# Use the same value for user, match, collab, and voice. Replace before sharing a deployment.
JWT_SECRET=change-this-to-a-long-random-secret

# MongoDB Connection
MONGO_URI=mongodb://mongo:27017
QUESTIONS_DB_NAME=peerprep
QUESTIONS_COLLECTION=questions

AI_PROVIDER=gemini
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_PROJECT_ID=

# AI Feedback & Fine-Tuning Configuration
FEEDBACK_CACHE_TTL=15m
FEEDBACK_EXPORT_ENABLED=false
FEEDBACK_EXPORT_SCHEDULE=0 2 * * 0
FEEDBACK_EXPORT_DIR=./exports
FEEDBACK_AUTO_TUNE_ENABLED=false
FEEDBACK_MIN_SAMPLES_FOR_TUNE=100
TUNING_BASE_MODEL=gemini-1.5-flash
TUNING_LEARNING_RATE=0.001
TUNING_EPOCH_COUNT=5
TUNING_ADAPTER_SIZE=ADAPTER_SIZE_ONE
TUNING_GCS_BUCKET=gs://your-bucket-name

CLIENT_BASE_URL=http://localhost:5173
USER_SERVICE_BASE_URL=http://localhost:8081

# Set these to real values only if you want registration and email flows.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
